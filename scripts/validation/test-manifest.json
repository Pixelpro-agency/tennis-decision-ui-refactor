{
  "schemaVersion": "1.0.0",
  "profiles": {
    "fast": {
      "enabled": true,
      "status": "implemented",
      "description": "Controlli puri e rapidi, senza browser, rete esterna o tracking."
    },
    "backend": {
      "enabled": true,
      "status": "implemented",
      "description": "Test backend offline registrati nel manifest."
    },
    "frontend": {
      "enabled": true,
      "status": "implemented",
      "description": "Test Node frontend registrati e build Vite."
    },
    "python": {
      "enabled": true,
      "status": "implemented",
      "description": "Compile check e unittest Python enumerati esplicitamente."
    },
    "full-offline": {
      "enabled": true,
      "status": "implemented",
      "description": "Tutte le entry offline abilitate, eseguite serialmente."
    },
    "persistence": {
      "enabled": false,
      "status": "planned",
      "description": "Harness isolato di persistence e recovery.",
      "reason": "Dipende da IMPL-008 e dalla sandbox persistence dedicata."
    },
    "benchmark": {
      "enabled": false,
      "status": "planned",
      "description": "Baseline ripetibili su fixture controllate.",
      "reason": "Dipende da IMPL-013; non è un gate ordinario."
    },
    "live": {
      "enabled": false,
      "status": "planned",
      "description": "Collaudi espliciti con fonti e browser reali.",
      "reason": "Non implementato e mai incluso nei profili predefiniti.",
      "liveRequired": true
    }
  },
